		padding-top: 10rpx;
		padding-bottom: 10rpx;
		border: 2rpx solid var(--color-line-soft);
		border-radius: 6rpx;
		background-color: var(--color-paper-2);
	}

	.result-row-egg {
		border: 3rpx solid var(--color-coin);
		background-color: var(--color-coin-soft);
	}

	.result-text {
