		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.pity-label-row {
		flex-direction: row;
		align-items: center;
	}

	.pity-label {
		font-size: 26rpx;
		color: var(--color-ink);
	}

	.pity-count {
		font-size: 26rpx;
		font-weight: bold;
		color: var(--color-coin);
	}

	.pity-bar {
		width: 100%;
		margin-top: 14rpx;
	}

	.pity-caption {
		font-size: 21rpx;
		color: var(--color-muted);
		margin-top: 10rpx;
	}

	.balance-area {
		align-items: center;
		margin-top: 40rpx;
	}

	.balance-line {
		flex-direction: row;
		align-items: center;
	}

	.balance-text {
		font-size: 52rpx;
		font-weight: bold;
		color: var(--color-coin);
	}

	.draw-actions {
		flex-direction: row;
		margin-top: 34rpx;
	}

	.single-btn {
		flex: 1;
		margin-right: 12rpx;
	}

	.ten-btn {
		flex: 1.4;
		margin-left: 12rpx;
	}

	.draw-btn-label {
		flex-direction: row;
		align-items: center;
	}

	.disabled-hint {
		font-size: 22rpx;
		color: var(--color-danger);
		text-align: center;
		margin-top: 14rpx;
	}

	.draw-stage {
		position: relative;
		height: 900rpx;
		margin-top: 24rpx;
		align-items: center;
		justify-content: flex-end;
	}

	.stage-halo {
		position: absolute;
		left: 50%;
		bottom: 260rpx;
		width: 390rpx;
		height: 390rpx;
		margin-left: -195rpx;
		border: 3rpx dashed var(--color-line-soft);
		border-radius: 999rpx;
		background-color: rgba(243, 227, 190, 0.32);
	}

	.stage-pedestal {
		position: absolute;
		left: 50%;
		bottom: 266rpx;
		width: 330rpx;
		height: 44rpx;
		margin-left: -165rpx;
		border: 3rpx solid var(--color-line);
		border-radius: 999rpx;
		background-color: #E5D6B9;
	}

	.stage-egg {
		position: absolute;
		left: 50%;
		bottom: 288rpx;
		width: 210rpx;
		margin-left: -105rpx;
		align-items: center;
		justify-content: center;
	}

	.stage-caption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 200rpx;
		text-align: center;
		font-size: 22rpx;
		letter-spacing: 1rpx;
		color: var(--color-muted);
	}

	/* 破壳弹层 */
	.draw-modal {
		padding-top: 30rpx;
	}

	.working-area {
		align-items: center;
	}

	.working-egg {
		align-items: center;
		justify-content: center;
	}

	.working-egg-cracked {
		transform: rotate(14deg);
	}

	.working-text {
		font-size: 30rpx;
		font-weight: bold;
		color: var(--color-ink);
		margin-top: 8rpx;
	}

	.working-egg-line {
		font-size: 22rpx;
		color: var(--color-muted);
		margin-top: 10rpx;
	}

	.result-area {
		width: 100%;
		align-items: center;
	}

	.reveal-area {
		align-items: center;
	}

	.reveal-flag {
		font-size: 27rpx;
		font-weight: bold;
		color: var(--color-coin);
		padding: 8rpx 20rpx;
		border: 3rpx solid var(--color-coin);
		border-radius: 6rpx;
		background-color: var(--color-coin-soft);
	}

	.reveal-name {
