		flex: 1;
		padding: 24rpx 28rpx 50rpx 28rpx;
	}

	.detail-content {
		flex-direction: column;
	}

	.header-area {
		align-items: center;
		padding-top: 10rpx;
	}

	.header-pet {
		align-items: center;
		justify-content: flex-end;
	}

	.pet-name {
		font-size: 40rpx;
		font-weight: bold;
		color: var(--color-ink);
		margin-top: 14rpx;
	}

	.pet-state {
		font-size: 24rpx;
		color: var(--color-muted);
		margin-top: 8rpx;
	}

	.action-panel {
		margin-top: 22rpx;
		padding: 20rpx 16rpx 10rpx 16rpx;
		border: 3rpx solid var(--color-line);
		border-radius: 8rpx;
		background-color: var(--color-paper-2);
	}

	.action-head {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-left: 8rpx;
		padding-right: 8rpx;
		margin-bottom: 12rpx;
	}

	.action-title {
		font-size: 26rpx;
		font-weight: bold;
		color: var(--color-ink);
	}

	.action-sub {
		font-size: 20rpx;
		color: var(--color-muted);
	}

	.action-grid {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.action-chip {
		width: 25%;
		height: 64rpx;
		align-items: center;
		justify-content: center;
		margin-bottom: 10rpx;
	}

	.action-chip-box {
		width: 86%;
		height: 54rpx;
		align-items: center;
		justify-content: center;
		border: 2rpx solid var(--color-line-soft);
		border-radius: 6rpx;
		background-color: var(--color-paper);
	}

	.action-chip-text {
		font-size: 22rpx;
		color: var(--color-ink);
	}

	.progress-card {
		margin-top: 26rpx;
		padding: 24rpx;
	}

	.progress-row {
		margin-bottom: 20rpx;
	}

	.progress-label {
		font-size: 26rpx;
		color: var(--color-ink);
		margin-bottom: 12rpx;
	}

	.progress-bar {
		width: 100%;
	}

	.feed-area {
		flex-direction: row;
		align-items: center;
		margin-top: 12rpx;
	}

	.feed-btn {
		flex: 1;
	}

	.feed-remain-row {
		flex-direction: row;
		align-items: center;
		margin-left: 20rpx;
	}

	.feed-remain {
		font-size: 24rpx;
		color: var(--color-muted);
	}

	.unlock-area {
		margin-top: 24rpx;
		align-items: center;
	}

	.unlock-wrap {
		width: 100%;
		align-items: center;
	}

	.unlock-btn {
		width: 100%;
	}

	.unlock-hint {
		font-size: 22rpx;
		color: var(--color-muted);
		margin-top: 12rpx;
	}

	.unlocked-text {
		width: 100%;
		text-align: center;
		font-size: 30rpx;
		font-weight: bold;
		color: var(--color-success);
		padding: 20rpx;
		border: 3rpx solid var(--color-success);
		border-radius: 8rpx;
		background-color: var(--color-success-soft);
	}

	.status-area {
		margin-top: 28rpx;
		padding: 20rpx;
		border-top: 2rpx solid var(--color-line-soft);
	}

	.status-label {
		font-size: 26rpx;
		font-weight: bold;
		color: var(--color-ink);
	}

	.status-desc {
		font-size: 22rpx;
		line-height: 1.6;
		color: var(--color-muted);
		margin-top: 10rpx;
	}

	.set-active-btn {
		align-self: flex-start;
		margin-top: 16rpx;
	}

	.chat-entry {
		margin-top: 24rpx;
	}

	.chat-entry-btn {
		width: 100%;
	}

	.modal-btn-row {
		width: 100%;
		flex-direction: row;
		margin-top: 28rpx;
	}

	.modal-btn {
		flex: 1;
