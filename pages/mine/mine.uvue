<template>
	<view class="mine-page buddy-page paper-texture">
		<scroll-view class="page-scroll" scroll-y :show-scrollbar="false">
			<!-- ① 概览：一行统计，不做卡片堆砌 -->
			<view class="overview-row">
				<view class="overview-item">
					<text class="overview-num buddy-display">{{ totals.petCount }}</text>
					<text class="overview-label">宠物</text>
				</view>
				<text class="overview-dot">·</text>
				<view class="overview-item">
					<text class="overview-num buddy-display">{{ totals.checkinDays }}</text>
					<text class="overview-label">打卡</text>
				</view>
				<text class="overview-dot">·</text>
				<view class="overview-item">
					<GameIcon icon="coin" :size="24" :mr="4" />
					<text class="overview-num buddy-display">{{ totals.coinsEarned }}</text>
					<text class="overview-label">累计</text>
				</view>
			</view>

			<!-- ② 背包 -->
			<text class="section-title">背包</text>
			<view class="bag-row">
				<view class="bag-card buddy-card">
					<GameIcon icon="food" :size="64" />
					<text class="bag-name">粮食</text>
					<text class="bag-count buddy-display">{{ foodCount }}</text>
				</view>
				<view class="bag-card buddy-card">
					<GameIcon icon="book" :size="64" />
					<text class="bag-name">书籍</text>
					<text class="bag-count buddy-display">{{ bookCount }}</text>
				</view>
			</view>

			<!-- ③ 流水入口 -->
			<view class="row-item" @click="goWallet">
				<view class="row-main">
					<GameIcon icon="coin" :size="34" :mr="10" />
					<text class="row-text buddy-display">货币流水</text>
				</view>
				<text class="row-arrow">›</text>
			</view>

			<!-- ④ 数据管理 -->
			<text class="section-title">数据管理</text>
			<view class="list-card buddy-card">
				<view class="list-row" @click="onExport">
					<view class="list-row-main">
						<text class="list-row-text">导出存档</text>
						<text class="list-row-sub">JSON，不含 API Key；复制到剪贴板</text>
					</view>
					<text class="row-arrow">›</text>
				</view>
				<view class="list-row" @click="openImport">
					<view class="list-row-main">
						<text class="list-row-text">导入存档</text>
						<text class="list-row-sub">全量覆盖本地数据</text>
					</view>
					<text class="row-arrow">›</text>
				</view>
				<view class="list-row" @click="onBackup">
					<view class="list-row-main">
						<text class="list-row-text">手动备份</text>
						<text class="list-row-sub">保存到应用本地，保留最近 7 份</text>
					</view>
					<text class="row-arrow">›</text>
				</view>
			</view>

			<!-- ⑤ 设置 -->
			<text class="section-title">设置</text>
			<view class="list-card buddy-card">
				<view class="list-row">
					<view class="list-row-main">
						<text class="list-row-text">打卡震动</text>
					</view>
					<view class="toggle" :class="vibrateOn ? 'toggle-on' : 'toggle-off'" @click="toggleVibrate">
						<text class="toggle-text" :class="vibrateOn ? 'toggle-text-on' : ''">{{ vibrateOn ? '开' : '关' }}</text>
					</view>
				</view>

				<view class="ai-block">
					<text class="ai-title">AI 接口（OpenAI 兼容，推荐 DeepSeek）</text>
					<input class="buddy-input ai-input" v-model="apiKey" placeholder="API Key"  />
					<input class="buddy-input ai-input" v-model="apiBase" placeholder="API Base，例如 https://api.deepseek.com/v1" />
					<input class="buddy-input ai-input" v-model="apiModel" placeholder="模型，例如 deepseek-chat" />
					<view class="buddy-btn buddy-btn-main save-btn" @click="onSaveAi">
						<text class="buddy-btn-text-inverse">保存 AI 配置</text>
					</view>
					<text class="ai-hint">Key 只存本机，导出存档会排除。H5 端需接口支持跨域（CORS），否则请填可用的代理地址。</text>
				</view>

				<view class="list-row" @click="onAbout">
					<text class="list-row-text">关于 / 版本 v{{ appVersion }}</text>
					<text class="row-arrow">›</text>
				</view>
			</view>

			<view class="mine-bottom-space"></view>
		</scroll-view>

		<!-- 导入弹层 -->
		<view v-if="showImport" class="buddy-mask" @click="closeImport">
			<view class="buddy-modal" @click.stop>
				<text class="buddy-modal-title">导入存档</text>
				<text class="import-warn">导入将覆盖当前数据，确认？</text>
				<textarea class="import-area" v-model="importText" placeholder="粘贴此前导出的 JSON 存档"></textarea>
				<view class="import-actions">
					<view class="buddy-btn import-clip" @click="onReadClipboard">
						<text class="buddy-btn-text">读剪贴板</text>
					</view>
					<view class="buddy-btn buddy-btn-main import-confirm" @click="onImportConfirm">
						<text class="buddy-btn-text-inverse">确认导入</text>
					</view>
				</view>
				<view class="import-cancel" @click="closeImport">
					<text class="import-cancel-text">取消</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { totals, foodCount, bookCount, settings, refreshStore } from '@/common/store.uts'
	import {
		updateVibrate,
		updateAiSettings,
		buildExportJson,
		importData,
		backupNow
	} from '@/common/repository.uts'
	import { APP_VERSION } from '@/common/constants.uts'
	import { copyText, readText } from '@/common/clipboard.uts'
	import GameIcon from '@/components/game-icon/game-icon.uvue'

	const appVersion = APP_VERSION
	const vibrateOn = ref(true)
	// 实际值由 syncSettings 从本地 settings 载入，不在源码里硬编码 Key
	const apiKey = ref('')
	const apiBase = ref('')
	const apiModel = ref('')
	const showImport = ref(false)
	const importText = ref('')

	function syncSettings(): void {
		vibrateOn.value = settings.value.vibrate
		apiKey.value = settings.value.apiKey
		apiBase.value = settings.value.apiBase
		apiModel.value = settings.value.apiModel
	}

	function goWallet(): void {
		uni.navigateTo({ url: '/pages/wallet/wallet' })
	}

	function onExport(): void {
		const text = buildExportJson()
		copyText(text, (ok: boolean) => {
			if (ok) {
				uni.showToast({ title: '存档已复制到剪贴板', icon: 'none' })
			} else {
				uni.showToast({ title: '复制失败，请稍后再试', icon: 'none' })
			}
		})
	}

	function openImport(): void {
		importText.value = ''
		showImport.value = true
	}

	function closeImport(): void {
		showImport.value = false
	}

	function onReadClipboard(): void {
		readText((text: string) => {
			if (text == '') {
				uni.showToast({ title: '剪贴板为空', icon: 'none' })
				return
			}
			importText.value = text
		})
	}

	function onImportConfirm(): void {
		if (importText.value.trim() == '') {
			uni.showToast({ title: '请先粘贴存档内容', icon: 'none' })
			return
		}
		if (!importData(importText.value)) {
			uni.showToast({ title: '存档格式不正确', icon: 'none' })
			return
		}
		showImport.value = false
		refreshStore()
		syncSettings()
		uni.showToast({ title: '数据已被同步', icon: 'none' })
	}

	function onBackup(): void {
		backupNow()
		uni.showToast({ title: '已备份到本地', icon: 'none' })
	}

	function toggleVibrate(): void {
		const next = !vibrateOn.value
		updateVibrate(next)
		refreshStore()
		vibrateOn.value = next
		if (next) {
			uni.vibrateShort({})
		}
	}

	function onSaveAi(): void {
		updateAiSettings(apiKey.value.trim(), apiBase.value.trim(), apiModel.value.trim())
		refreshStore()
		syncSettings()
		uni.showToast({ title: 'AI 配置已保存', icon: 'none' })
	}

	function onAbout(): void {
		uni.showModal({
			title: '关于 buddy',
			content: `运动打卡宠物养成，个人自用。\n版本 v${APP_VERSION}`,
			showCancel: false
		})
	}

	onShow(() => {
		refreshStore()
		syncSettings()
	})
</script>

