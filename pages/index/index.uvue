	.gift-inner {
		position: absolute;
		left: 7rpx;
		right: 7rpx;
		top: 7rpx;
		bottom: 7rpx;
		border: 2rpx dashed rgba(58, 52, 44, 0.45);
		border-radius: 4rpx;
	}

	.gift-text {
		position: relative;
		z-index: 2;
		font-size: 32rpx;
		font-weight: bold;
