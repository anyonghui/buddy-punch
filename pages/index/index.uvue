		flex: 1;
		/* 首页无标题栏，顶部留出状态栏与呼吸空间 */
		padding: 92rpx 32rpx 16rpx 32rpx;
	}

	.home-inner {
		width: 100%;
		flex-direction: column;
	}

	/* ===== ① 顶部状态条 ===== */
	.home-status {
		height: 108rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
