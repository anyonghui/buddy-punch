		z-index: 2;
	}

	.coin-bubble {
		position: absolute;
		top: 0;
		left: -26rpx;
		flex-direction: row;
		align-items: center;
		padding: 8rpx 16rpx;
		border: 3rpx solid var(--color-coin);
		border-radius: 8rpx;
		background-color: var(--color-coin-soft);
		z-index: 5;
	}

	.coin-bubble-text {
		font-size: 30rpx;
		font-weight: bold;
		color: var(--color-coin);
	}

	.chat-badge {
		position: absolute;
		top: 8rpx;
		right: -10rpx;
		width: 52rpx;
		height: 52rpx;
		align-items: center;
		justify-content: center;
		border: 2rpx solid var(--color-line);
		border-radius: 8rpx;
		background-color: var(--color-paper-2);
		z-index: 5;
	}

	.chat-badge-text {
		font-size: 26rpx;
	}

	.pet-info {
		position: absolute;
