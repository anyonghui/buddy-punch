		border-radius: 2rpx;
		transform: rotate(-0.4deg);
	}

	.dirt-patch {
		position: absolute;
		left: 50%;
		bottom: 246rpx;
		width: 340rpx;
		height: 48rpx;
		margin-left: -170rpx;
		border: 3rpx solid var(--color-line);
		border-radius: 999rpx;
		background-color: #E5D6B9;
	}

	.grass {
		position: absolute;
		bottom: 258rpx;
		width: 110rpx;
		height: 60rpx;
	}

	.grass-left {
		left: 34rpx;
	}

	.grass-right {
		right: 34rpx;
	}

	.blade {
		position: absolute;
		bottom: 0;
