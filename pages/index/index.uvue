<template>
	<view class="home buddy-page paper-texture">
		<scroll-view class="page-scroll" scroll-y :show-scrollbar="false">
			<view class="home-inner">
				<!-- ① 顶部状态条 -->
				<view class="home-status">
					<view class="streak-line">
						<text class="streak-label">连续</text>
						<view class="streak-num-box">
							<text class="streak-num buddy-display">{{ streakDays }}</text>
						</view>
						<text class="streak-label">天</text>
					</view>
					<view class="status-right">
						<view class="coin-line">
							<GameIcon icon="coin" :size="44" :mr="6" />
							<text class="coin-text buddy-display">{{ coinBalance }}</text>
						</view>
						<!-- 抽奖入口：印章式方块，不用渐变流光 -->
						<view class="gift-btn" @click="goDraw">
							<view class="gift-inner"></view>
							<text class="gift-text">抽</text>
						</view>
					</view>
				</view>

				<!-- ② 陪伴宠物区：手绘地面 + 大宠物 -->
				<view class="pet-area">
					<view v-if="hasPet" class="pet-scene">
						<view class="ground-line"></view>
						<view class="dirt-patch"></view>
						<view class="grass grass-left">
							<view class="blade blade-a"></view>
							<view class="blade blade-b"></view>
							<view class="blade blade-c"></view>
						</view>
						<view class="grass grass-right">
							<view class="blade blade-d"></view>
							<view class="blade blade-e"></view>
							<view class="blade blade-f"></view>
						</view>

						<view class="pet-stage" @click="onPetTap">
							<view v-if="passiveTip" class="coin-bubble">
								<text class="coin-bubble-text">+{{ passiveAmount }}</text>
								<GameIcon icon="coin" :size="26" :ml="4" />
							</view>
							<!-- <view v-if="activePetChatUnlocked" class="chat-badge">
								<text class="chat-badge-text">💬</text>
							</view> -->
							<PetSprite :petKey="activePetKey" :state="displayState" :height="540" :playing="true"
								:speed="animSpeed" />
						</view>

						<view class="pet-info">
							<view class="pet-name-wrap">
								<view class="name-highlight"></view>
								<text class="pet-name buddy-display">{{ activePetName }}</text>
							</view>
							<view class="pet-state-row">
								<view class="state-dot"></view>
								<text class="pet-state">{{ wilting ? '蔫了' : '开心' }} · 陪伴中</text>
							</view>
							<text v-if="wilting" class="pet-hint">连续训练日断档了，完成今天打卡就能恢复</text>
						</view>
					</view>

					<view v-else class="pet-empty">
						<GameIcon icon="egg" :size="100" />
						<text class="pet-empty-text">还没有宠物伙伴</text>
						<view class="buddy-btn buddy-btn-main pet-claim-btn" @click="onClaim">
							<text class="buddy-btn-text-inverse">领取初始宠物</text>
						</view>
					</view>
				</view>

				<!-- ③ 今日打卡：票根 -->
				<view class="checkin-area">
					<view v-if="!hasPet" class="checkin-locked">
						<text class="checkin-locked-text">领取宠物后开始打卡</text>
					</view>
					<view v-else-if="todayChecked" class="ticket-wrap">
						<view class="ticket-stage">
							<view class="ticket ticket-done">
								<view class="ticket-stub ticket-stub-done">
									<text class="ticket-stub-main ticket-text-primary">今日</text>
									<text class="ticket-stub-sub ticket-text-primary">DONE</text>
								</view>
								<view class="ticket-body">
									<text class="ticket-title ticket-text-primary">今日已打卡 ✓</text>
									<text class="ticket-gain ticket-text-primary buddy-display">+{{ todayCoinEarned }}</text>
									<GameIcon icon="coin" :size="34" />
								</view>
							</view>
							<view class="stamp stamp-done">
								<view class="stamp-inner stamp-inner-done"></view>
								<text class="stamp-text stamp-text-done">OK</text>
							</view>
						</view>
					</view>
					<view v-else class="ticket-wrap">
						<view v-if="!wilting" class="now-hint">
							<text class="now-note buddy-display">就现在</text>
							<text class="now-arrow">↘</text>
						</view>
						<view class="ticket-stage">
							<view class="ticket" :class="todayTraining ? 'ticket-main' : 'ticket-rest'" @click="onCheckin">
								<view class="ticket-stub" :class="todayTraining ? 'ticket-stub-inverse' : ''">
									<text class="ticket-stub-main" :class="todayTraining ? 'ticket-text-inverse' : 'ticket-text-ink'">今日</text>
									<text class="ticket-stub-sub" :class="todayTraining ? 'ticket-text-inverse' : 'ticket-text-ink'">TODAY</text>
								</view>
								<view class="ticket-body">
									<text class="ticket-title" :class="todayTraining ? 'ticket-text-inverse' : 'ticket-text-ink'">{{ checkinTitle }}</text>
									<text class="ticket-gain buddy-display" :class="todayTraining ? 'ticket-text-inverse' : 'ticket-text-ink'">+{{ todayCoin }}</text>
									<GameIcon icon="coin" :size="34" />
								</view>
							</view>
							<view class="stamp">
								<view class="stamp-inner"></view>
								<text class="stamp-text">GO</text>
							</view>
						</view>
					</view>
				</view>

				<!-- ④ 全勤：旗子小路 -->
				<view class="week-area">
					<view v-if="fullweek.canClaim" class="week-claim" @click="onClaimFullweek">
						<GameIcon icon="gift" :size="38" :mr="8" />
						<text class="week-claim-text">领取全勤宝箱 +20</text>
						<GameIcon icon="coin" :size="28" :ml="6" />
					</view>
					<view v-else class="week-body">
						<view class="week-head">
							<text class="week-title">本周全勤</text>
							<text class="week-sub">{{ weekCaption }}</text>
						</view>
						<view class="week-map">
							<view class="week-path"></view>
							<view class="week-flags">
								<view v-for="d in fullweek.days" :key="d.label" class="week-flag"
									:class="d.label == todayFlagLabel ? 'week-flag-today' : ''">
									<text v-if="d.label == todayFlagLabel" class="flag-today">今天</text>
									<view class="flag-body">
										<view class="flag-pole"></view>
										<view class="flag-cloth" :class="d.done ? 'flag-cloth-done' : ''">
											<text v-if="d.done" class="flag-check">✓</text>
										</view>
									</view>
									<text class="flag-label" :class="d.label == todayFlagLabel ? 'flag-label-today' : ''">{{ d.label }}</text>
								</view>
								<view class="chest">
									<view class="chest-lid"></view>
									<view class="chest-body">
										<view class="chest-lock"></view>
									</view>
								</view>
							</view>
						</view>
						<view class="week-foot">
							<text class="week-foot-text">{{ weekFootText }}</text>
							<text class="week-foot-date">{{ todayDateLabel }}</text>
						</view>
					</view>
				</view>

				<!-- ⑤ 页脚手写便签 -->
				<view v-if="hasPet" class="note-wrap">
					<view class="page-note">
						<view class="note-tape"></view>
						<text class="note-text buddy-display">今天也来动一下吧</text>
					</view>
				</view>

				<view class="home-bottom-space"></view>
			</view>
		</scroll-view>

		<!-- 打卡成功反馈 -->
		<view v-if="showCheckinModal" class="buddy-mask" @click="closeCheckin">
			<view class="buddy-modal" @click.stop>
				<PetSprite v-if="hasPet" :petKey="activePetKey" state="jump" :height="200" :playing="true" />
				<text class="buddy-modal-title">打卡完成！</text>
				<view class="gain-line">
					<text class="checkin-gain buddy-display">+{{ lastOutcome.total }}</text>
					<GameIcon icon="coin" :size="42" :ml="6" />
				</view>
				<view v-if="lastOutcome.bonus > 0" class="bonus-line">
					<text class="checkin-bonus">连续训练奖励 +{{ lastOutcome.bonus }}</text>
					<GameIcon icon="coin" :size="24" :ml="4" />
				</view>
				<text class="buddy-modal-text">{{ encourageText }}</text>
				<view class="buddy-btn buddy-btn-main buddy-modal-btn" @click="closeCheckin">
					<text class="buddy-btn-text-inverse">好的</text>
				</view>
			</view>
		</view>

		<!-- 全勤宝箱 -->
		<view v-if="showFullweekModal" class="buddy-mask" @click="closeFullweek">
			<view class="buddy-modal" @click.stop>
				<GameIcon icon="gift" :size="80" />
				<text class="buddy-modal-title">全勤达成</text>
				<view class="gain-line">
					<text class="checkin-gain buddy-display">+20</text>
					<GameIcon icon="coin" :size="42" :ml="6" />
				</view>
				<text class="buddy-modal-text">一周四个训练日全部完成，宝箱已入账。</text>
				<view class="buddy-btn buddy-btn-main buddy-modal-btn" @click="closeFullweek">
					<text class="buddy-btn-text-inverse">好的</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import PetSprite from '@/components/pet-sprite/pet-sprite.uvue'
	import GameIcon from '@/components/game-icon/game-icon.uvue'
	import {
		coinBalance,
		streakDays,
		wilting,
		hasPet,
		activePetKey,
		activePetName,
		activePetChatUnlocked,
		todayChecked,
		todayCoinEarned,
		todayTraining,
		todayCoin,
		fullweek,
		settings,
		refreshStore
	} from '@/common/store.uts'
	import { claimInitialPet, performCheckin, claimPassiveCoin, claimFullweek } from '@/common/repository.uts'
	import { todayStr, nowIso, isTrainingDate, weekdayLabel } from '@/common/date.uts'
	import { CheckinOutcome } from '@/common/types.uts'

	// 宠物帧播放减速倍数：1.5 = 慢 1.5 倍
	const animSpeed = 1.5

	// 点击互动：waving / jumping 播 1 轮后回 idle
	const interactState = ref('')
	const passiveTip = ref(false)
	const passiveAmount = ref(1)
	const showCheckinModal = ref(false)
	const showFullweekModal = ref(false)
	const lastOutcome = ref<CheckinOutcome>(new CheckinOutcome())
	const encourageText = ref('')

	let interactTimer = -1
	let passiveTimer = -1
	let lastTapAt = 0

	const trainWords: string[] = [
		'练完啦，今天的你闪闪发光。',
		'累是累，但你做到了。',
		'我数着呢，一下都没偷懒。',
		'肌肉在偷偷长大，别告诉别人。',
		'完成训练的你，值得被夸一句。'
	]

	const restWords: string[] = [
		'休息也是训练的一部分。',
		'今天慢慢走，明天继续冲。',
		'拉伸一下，别让身体锈住。',
		'歇好了，才有力气陪我玩。',
		'偷得浮生半日闲，准了。'
	]

	const displayState = computed((): string => {
		if (wilting.value) {
			return 'failed'
		}
		if (interactState.value != '') {
			return interactState.value
		}
		return 'idle'
	})

	const checkinTitle = computed((): string => {
		return todayTraining.value ? '完成训练' : '休息打卡'
	})

	const weekCaption = computed((): string => {
		const info = fullweek.value
		if (info.claimed) {
			return '本周已领取'
		}
		if (info.canClaim) {
			return '宝箱可领取'
		}
		if (info.missing > 0) {
			return `差 ${info.missing} 天全勤`
		}
		return '周日可领取全勤宝箱'
	})

	const weekFootText = computed((): string => {
		const info = fullweek.value
		if (info.claimed) {
			return '本周已领取，下周继续'
		}
		if (info.missing > 0) {
			return `再练 ${info.missing} 天，就能开宝箱`
		}
		return '本周全勤已达成'
	})

	// 首页四个训练日标签只显示「一/三/五/六」，今天标签去掉“周”字
	const todayFlagLabel = computed((): string => {
		return weekdayLabel(todayStr()).substring(1)
	})

	const todayDateLabel = computed((): string => {
		const t = todayStr()
		return `${t.substring(5, 7)}.${t.substring(8, 10)} ${weekdayLabel(t)}`
	})

	function clearInteractTimer(): void {
		if (interactTimer != -1) {
			clearTimeout(interactTimer)
			interactTimer = -1
		}
	}

	function clearPassiveTimer(): void {
		if (passiveTimer != -1) {
			clearTimeout(passiveTimer)
			passiveTimer = -1
		}
	}

	function checkPassive(): void {
		if (!hasPet.value) {
			return
		}
		if (!claimPassiveCoin()) {
			return
		}
		refreshStore()
		passiveTip.value = true
		passiveAmount.value = 1
		interactState.value = 'wave'
		clearPassiveTimer()
		passiveTimer = setTimeout(() => {
			passiveTip.value = false
			if (interactState.value == 'wave') {
				interactState.value = ''
			}
			passiveTimer = -1
		}, 2000)
	}

	function onPetTap(): void {
		if (!hasPet.value) {
			return
		}
		// 产币提示可点击关闭
		if (passiveTip.value) {
			passiveTip.value = false
			clearPassiveTimer()
			if (interactState.value == 'wave') {
				interactState.value = ''
			}
			return
		}
		if (wilting.value) {
			return
		}
		const now = Date.now()
		if (now - lastTapAt < 1000) {
			return
		}
		lastTapAt = now
		const state = Math.random() < 0.5 ? 'wave' : 'jump'
		interactState.value = state
		clearInteractTimer()
		interactTimer = setTimeout(() => {
			interactState.value = ''
			interactTimer = -1
		}, 1100)
	}

	function onCheckin(): void {
		if (!hasPet.value || todayChecked.value) {
			return
		}
		const today = todayStr()
		const kind = isTrainingDate(today) ? 'train' : 'rest'
		const out = performCheckin(today, kind, nowIso())
		if (!out.ok) {
			uni.showToast({ title: out.reason, icon: 'none' })
			return
		}
		lastOutcome.value = out
		const words = isTrainingDate(today) ? trainWords : restWords
		encourageText.value = words[Math.floor(Math.random() * words.length)]
		refreshStore()
		interactState.value = 'jump'
		showCheckinModal.value = true
		if (settings.value.vibrate) {
			uni.vibrateShort({})
		}
	}

	function onClaim(): void {
		const pet = claimInitialPet()
		if (pet == null) {
			uni.showToast({ title: '领取失败，请稍后再试', icon: 'none' })
			return
		}
		refreshStore()
		interactState.value = 'jump'
		clearInteractTimer()
		interactTimer = setTimeout(() => {
			interactState.value = ''
			interactTimer = -1
		}, 1200)
	}

	function onClaimFullweek(): void {
		if (!claimFullweek()) {
			uni.showToast({ title: '还不满足领取条件', icon: 'none' })
			return
		}
		refreshStore()
		showFullweekModal.value = true
		if (settings.value.vibrate) {
			uni.vibrateShort({})
		}
	}

	function closeCheckin(): void {
		showCheckinModal.value = false
		interactState.value = ''
		refreshStore()
	}

	function closeFullweek(): void {
		showFullweekModal.value = false
	}

	function goDraw(): void {
		uni.navigateTo({ url: '/pages/draw/draw' })
	}

	onShow(() => {
		refreshStore()
		checkPassive()
	})

	onHide(() => {
		clearInteractTimer()
		clearPassiveTimer()
		passiveTip.value = false
		interactState.value = ''
	})

	onUnload(() => {
		clearInteractTimer()
		clearPassiveTimer()
	})
</script>

<style lang="scss" scoped>
