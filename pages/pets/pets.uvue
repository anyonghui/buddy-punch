<template>
	<view class="pets-page buddy-page paper-texture">
		<scroll-view class="page-scroll" scroll-y :show-scrollbar="false">
			<view v-if="hasPet" class="active-card buddy-card" @click="goDetail(activePetId)">
				<PetSprite :petKey="activePetKey" :state="wilting ? 'failed' : 'idle'" :height="140" :playing="false" />
				<view class="active-info">
					<text class="active-name buddy-display">{{ activePetName }}</text>
					<text class="active-status">{{ wilting ? '蔫了' : '开心' }} · 陪伴中</text>
				</view>
				<text v-if="activePetChatUnlocked" class="active-badge">💬</text>
				<text class="active-arrow">›</text>
			</view>

			<view v-if="pets.length > 0" class="pet-grid">
				<view v-for="p in pets" :key="p.id" class="pet-card buddy-card" @click="goDetail(p.id)">
					<view class="pet-card-art">
						<PetSprite :petKey="p.petKey" :state="wilting ? 'failed' : 'idle'" :height="180" :playing="false" />
						<view v-if="p.chatUnlocked" class="card-badge">
							<text class="card-badge-text">💬</text>
						</view>
					</view>
					<text class="pet-card-name buddy-display">{{ p.name }}</text>
					<view class="pet-card-action">
						<text v-if="p.isActive" class="serving-text">● 陪伴中</text>
						<view v-else class="buddy-btn buddy-btn-small" @click.stop="onSetActive(p.id, p.name)">
							<text class="buddy-btn-text-small">设为陪伴</text>
						</view>
					</view>
				</view>
			</view>

			<view v-else class="buddy-empty">
				<text class="buddy-empty-icon">🐾</text>
				<text class="buddy-empty-text">还没有宠物，回首页领取初始伙伴</text>
				<view class="buddy-btn buddy-btn-main empty-btn" @click="goHome">
					<text class="buddy-btn-text-inverse">回首页</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import PetSprite from '@/components/pet-sprite/pet-sprite.uvue'
	import {
		pets,
		hasPet,
		wilting,
		activePetId,
		activePetKey,
		activePetName,
		activePetChatUnlocked,
		refreshStore
	} from '@/common/store.uts'
	import { setActivePet } from '@/common/repository.uts'

	function goDetail(petId: number): void {
		uni.navigateTo({ url: `/pages/pet-detail/pet-detail?petId=${petId}` })
	}

	function onSetActive(petId: number, name: string): void {
		if (setActivePet(petId)) {
			refreshStore()
			uni.showToast({ title: `现在由 ${name} 陪伴你`, icon: 'none' })
		}
	}

	function goHome(): void {
		uni.switchTab({ url: '/pages/index/index' })
	}

	onShow(() => {
		refreshStore()
	})
</script>

<style lang="scss" scoped>
	.pets-page {
		flex: 1;
		padding: 28rpx;
	}

	.active-card {
		flex-direction: row;
		align-items: center;
		height: 180rpx;
		padding-left: 20rpx;
		padding-right: 24rpx;
	}

	.active-info {
		flex: 1;
		margin-left: 24rpx;
	}

	.active-name {
		font-size: 36rpx;
		font-weight: bold;
		color: var(--color-ink);
	}

	.active-status {
		font-size: 24rpx;
		color: var(--color-muted);
		margin-top: 10rpx;
	}

	.active-badge {
		font-size: 28rpx;
		margin-right: 10rpx;
	}

	.active-arrow {
		font-size: 40rpx;
		color: var(--color-muted);
	}

	.pet-grid {
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: space-between;
		margin-top: 22rpx;
	}

	.pet-card {
		width: 48.5%;
		margin-bottom: 20rpx;
		padding-top: 20rpx;
		padding-bottom: 20rpx;
		align-items: center;
	}

	.pet-card-art {
		position: relative;
		align-items: center;
		justify-content: flex-end;
		min-height: 190rpx;
	}

	.card-badge {
		position: absolute;
		top: 0;
		right: 10rpx;
		width: 44rpx;
		height: 44rpx;
		align-items: center;
		justify-content: center;
		border: 2rpx solid var(--color-line);
		border-radius: 6rpx;
		background-color: var(--color-paper-2);
	}

	.card-badge-text {
		font-size: 24rpx;
	}

	.pet-card-name {
		font-size: 28rpx;
		font-weight: bold;
		color: var(--color-ink);
		margin-top: 12rpx;
	}

	.pet-card-action {
		height: 60rpx;
		align-items: center;
		justify-content: center;
		margin-top: 8rpx;
	}

	.serving-text {
		font-size: 22rpx;
		color: var(--color-success);
	}

	.empty-btn {
		width: 320rpx;
	}
</style>

