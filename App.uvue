<script setup lang="uts">
	import { initDatabase, autoDailyBackup } from '@/common/repository.uts'
	import { refreshStore } from '@/common/store.uts'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		initDatabase()
		autoDailyBackup()
		refreshStore()
	})

	onAppShow(() => {
		refreshStore()
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom'
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})
	// #endif
</script>

<style lang="scss">
